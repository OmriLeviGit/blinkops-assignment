# Copy to .env and fill in. tforge reads ./.env from the directory you run it in.
# Precedence: real environment variables > .env > saved config (`tforge setup`).
# .env is git-ignored; never commit real credentials.

TFORGE_USERNAME=
TFORGE_PASSWORD=

# Optional: defaults to https://integrations-assignment-ticketforge.vercel.app
# TFORGE_BASE_URL=
